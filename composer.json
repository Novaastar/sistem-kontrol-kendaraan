{
  "require-dev": {
    "phpunit/phpunit": "^12.5",
    "pestphp/pest": "^4.0"
  },
  "autoload-dev": {
    "psr-4": {
      "Skk\\Tests\\": "tests/api/"
    }
  },
  "scripts": {
    "test:phpunit": "phpunit --testsuite phpunit",
    "test:pest": "pest tests/api/UpdatePerjalananPestTest.php",
    "test": [
      "@test:phpunit",
      "@test:pest"
    ]
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
